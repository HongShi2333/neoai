# NeoAI Frontend Environment Configuration
# Copy this file to .env and customize for your deployment

# Application name and branding
VITE_APP_NAME=NeoAI
VITE_APP_LOGO=/favicon.ico

# Backend API endpoint (REQUIRED for separate frontend/backend deployment)
# Examples:
#   - Same origin: /api
#   - Cross origin: https://api.your-domain.com
VITE_BACKEND_ENDPOINT=/api

# Documentation site URL
VITE_DOCS_ENDPOINT=https://neoai.dev

# Blob storage endpoint for file uploads
VITE_BLOB_ENDPOINT=https://blob.neoai.dev

# Optional: enable DeepTrain auth mode (default: disabled)
# VITE_USE_DEEPTRAIN=false
# VITE_DEEPTRAIN_ENDPOINT=https://deeptrain.net
# VITE_DEEPTRAIN_APP=neoai
# VITE_DEEPTRAIN_API_ENDPOINT=https://api.deeptrain.net

# Optional: buy link for marketplace
# VITE_BUY_LINK=
