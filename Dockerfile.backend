# Dockerfile.backend — build only the Go backend, for split deployments
# where the frontend is hosted separately (e.g. on a CDN or static host).
#
# Build:
#   docker build -f Dockerfile.backend -t neoai-backend .
# Run:
#   docker run -p 8094:8094 -v $(pwd)/config:/config -v $(pwd)/logs:/logs \
#     -v $(pwd)/storage:/storage \
#     -e CACHE_TYPE=valkey -e CACHE_HOST=host.docker.internal \
#     -e MYSQL_HOST=host.docker.internal -e MYSQL_USER=root \
#     -e MYSQL_PASSWORD=secret -e MYSQL_DB=neoai \
#     neoai-backend

FROM --platform=$TARGETPLATFORM golang:1.20-alpine AS builder

WORKDIR /backend
COPY . .

ARG TARGETARCH
ARG TARGETOS
ENV GOOS=$TARGETOS GOARCH=$TARGETARCH GO111MODULE=on CGO_ENABLED=1

RUN apk update && \
    apk add --no-cache gcc musl-dev g++ make linux-headers

RUN go build -o neoai -a -ldflags="-extldflags=-static" .

FROM alpine

RUN apk upgrade --no-cache && \
    apk add --no-cache wget ca-certificates tzdata && \
    update-ca-certificates 2>/dev/null || true

RUN echo "Asia/Shanghai" > /etc/timezone && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime

WORKDIR /

COPY --from=builder /backend/neoai /neoai
COPY --from=builder /backend/config.example.yaml /config.example.yaml
COPY --from=builder /backend/utils/templates /utils/templates
COPY --from=builder /backend/addition/article/template.docx /addition/article/template.docx

# NOTE: serve_static must be `false` when running without the bundled
# frontend. The bundled `app/dist` is intentionally NOT copied here.

VOLUME ["/config", "/logs", "/storage"]

EXPOSE 8094

CMD ["./neoai"]
